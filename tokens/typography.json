{
  "$description": "Typography rules matching the current application.",
  "font": {
    "family": {
      "system": {
        "$type": "fontFamily",
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "small": { "$type": "dimension", "$value": "12px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "title": { "$type": "dimension", "$value": "20px" },
      "headline": { "$type": "dimension", "$value": "24px" },
      "display": { "$type": "dimension", "$value": "36px" }
    },
    "line-height": {
      "compact": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.5 }
    }
  }
}
