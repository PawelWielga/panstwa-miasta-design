{
  "name": "@pawelwielga/panstwa-miasta-design",
  "version": "0.2.0",
  "description": "Shared design tokens and brand assets for the Panstwa Miasta game.",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "tokens",
    "assets",
    "docs",
    "packages/flutter"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./assets/manifest.json": "./assets/manifest.json",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "npm run validate && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  }
}
